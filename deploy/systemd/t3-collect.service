[Unit]
Description=CASM T3 artifact collector + Slack poster (corr1)
After=network-online.target

[Service]
ExecStart=/home/casm/software/dev/casm_venvs/casm_offline_env/bin/t3-collect --log-file /mnt/nvme5/casm_pipeline/logs/t3_collect.log
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
